{
	"name": "sync-engine",
	"version": "0.0.1",
	"private": true,
	"license": "MIT",
	"workspaces": [
		"./packages/*",
		"./docs"
	],
	"type": "module",
	"scripts": {
		"postinstall": "cd packages/plugin && bun compile",
		"dev:plugin": "cd packages/plugin && bun --bun dev:plugin",
		"build:plugin": "cd packages/plugin && bun --bun build:plugin",
		"dev:docs": "cd docs && bun --bun dev:docs",
		"build:docs": "cd docs && bun --bun build:docs",
		"dev": "bun --bun turbo run dev",
		"compile": "bun --bun turbo run compile",
		"ver": "bun scripts/version-bump.ts",
		"fix": "bun --bun turbo run fix",
		"check": "bun --bun turbo run check",
		"tests": "bun --bun turbo run tests"
	},
	"devDependencies": {
		"@obsidian-typings/obsidian-public-latest": "^6.32.0",
		"@tsdown/css": "^0.22.14",
		"@types/bun": "^1.3.14",
		"obsidian": "^1.13.1",
		"oxfmt": "^0.63.0",
		"oxlint": "^1.78.0",
		"oxlint-tsgolint": "^7.0.2001",
		"tsdown": "^0.22.14",
		"turbo": "^2.10.9",
		"typescript": "^7.0.2"
	},
	"packageManager": "bun@1.3.13"
}
