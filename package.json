{
	"name": "sync-engine",
	"version": "0.0.1",
	"private": true,
	"license": "MIT",
	"workspaces": [
		"./packages/*",
		"./docs"
	],
	"type": "module",
	"scripts": {
		"postinstall": "turbo run dev -F @hesprs/sync-engine-sdk",
		"dev:plugin": "cd packages/plugin && bun dev:plugin",
		"build:plugin": "cd packages/plugin && bun build:plugin",
		"dev:docs": "cd docs && bun dev:docs",
		"build:docs": "cd docs && bun build:docs",
		"dev": "turbo run dev",
		"compile": "turbo run compile",
		"ver": "bun scripts/version-bump.ts",
		"fix": "turbo run fix",
		"check": "turbo run check",
		"tests": "turbo run tests"
	},
	"devDependencies": {
		"@hesprs/harness": "catalog:",
		"@obsidian-typings/obsidian-public-latest": "^6.41.0",
		"@tsdown/css": "^0.23.1",
		"@types/bun": "^1.4.2",
		"obsidian": "catalog:",
		"oxfmt": "^0.72.0",
		"oxlint": "^1.87.0",
		"oxlint-tsgolint": "^7.0.2004",
		"tsdown": "^0.23.1",
		"turbo": "^2.11.7",
		"typescript": "^6.0.3"
	},
	"packageManager": "bun@1.4.2",
	"catalog": {
		"hash-wasm": "^4.12.0",
		"uni-kv": "./uni-kv.tgz",
		"@hesprs/harness": "./harness.tgz",
		"synthkernel": "./synthkernel.tgz",
		"obsidian": "^1.14.4"
	}
}
