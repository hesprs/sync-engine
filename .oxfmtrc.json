{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"printWidth": 100,
	"tabWidth": 4,
	"useTabs": true,
	"endOfLine": "lf",
	"singleQuote": true,
	"sortImports": {
		"newlinesBetween": false,
		"groups": ["unknown", "value-import", "type-import"]
	},
	"proseWrap": "never",
	"objectWrap": "collapse",
	"embeddedLanguageFormatting": "auto",
	"jsdoc": { "preferCodeFences": true, "bracketSpacing": true },
	"overrides": [
		{ "files": ["*.md", "*.yaml", "*.yml"], "options": { "tabWidth": 2, "useTabs": false } }
	],
	"ignorePatterns": ["**/node_modules/**", "**/dist/**", "**/public/**"]
}
