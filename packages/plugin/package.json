{
	"name": "@hesprs/sync-engine-sdk",
	"version": "3.4.3",
	"description": "Official SDK for developing modules targeting Sync Engine, the extensible Obsidian syncing plugin.",
	"keywords": [
		"obsidian-plugin",
		"sdk",
		"synchronization"
	],
	"homepage": "https://sync.consensia.cc",
	"bugs": {
		"url": "https://github.com/hesprs/sync-engine/issues"
	},
	"license": "MIT",
	"author": {
		"name": "Hēsperus"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hesprs/sync-engine.git"
	},
	"files": [
		"./dist"
	],
	"type": "module",
	"sideEffects": false,
	"module": "./dist/index.js",
	"types": "./dist/index.spec.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.spec.d.ts",
			"default": "./dist/index.js"
		},
		"./dev": {
			"types": "./dist/dev.spec.d.ts",
			"default": "./dist/dev.js"
		},
		"./tsdown-plugin": {
			"types": "./dist/tsdown-plugin.spec.d.ts",
			"default": "./dist/tsdown-plugin.js"
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"dev:plugin": "MODE=dev BUILD=plugin tsdown",
		"build:plugin": "BUILD=plugin tsdown",
		"dev": "MODE=dev PASS=dts tsdown && MODE=dev tsdown",
		"compile": "PASS=dts tsdown && tsdown",
		"fix": "oxlint --silent --fix && bun fmt",
		"check": "oxlint && bun fmt --check",
		"tests": "bun test --parallel"
	},
	"dependencies": {
		"@obsidian-typings/obsidian-public-latest": "catalog:",
		"obsidian": "catalog:"
	},
	"devDependencies": {
		"@repo/shared": "workspace:*",
		"@unocss/postcss": "^66.12.0",
		"postcss-merge-rules": "^9.1.5",
		"solid-js": "^1.9.18",
		"synthkernel": "catalog:",
		"uni-kv": "catalog:",
		"unocss": "^66.12.0",
		"unplugin-solid": "^2.0.0",
		"verkit": "^0.5.0"
	}
}
