{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "stream",
	"noUpdateNotifier": true,
	"concurrency": "100%",
	"agentGuidance": false,
	"globalDependencies": ["bunfig.toml", ".oxlintrc.json"],
	"tasks": {
		"compile": {
			"dependsOn": ["^compile"],
			"env": ["GDRIVE_CLIENT_ID", "GDRIVE_CLIENT_SECRET", "DROPBOX_APP_KEY"],
			"outputs": ["dist/**"],
			"cache": true
		},
		"dev": {
			"dependsOn": ["^dev"],
			"outputs": ["dist/**"],
			"cache": true,
			"env": ["GDRIVE_CLIENT_ID", "GDRIVE_CLIENT_SECRET", "DROPBOX_APP_KEY"]
		},
		"fix": { "dependsOn": ["^fix"], "cache": true },
		"check": { "cache": true, "dependsOn": ["^dev"] },
		"tests": { "dependsOn": ["^dev"], "cache": true }
	}
}
